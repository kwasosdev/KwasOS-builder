echo "=========================================="
echo " KwasOS Live - initializing"
echo "=========================================="

# FIX: без /dev/console (created by kernel? only if CONFIG_DEVPTS and init
#      opens it) busybox sh fails. Ensure console node exists early.
[ -c /dev/console ] || /bin/busybox mknod /dev/console c 5 1 2>/dev/null

/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev

# mdev для hotplug-событий (авто-создание /dev/sdX)
echo /sbin/mdev > /proc/sys/kernel/hotplug
/bin/busybox mdev -s
echo "[init] mdev started"

# Явно грузим драйверы (на случай если они =m)
for mod in xhci_hcd xhci_pci ehci_hcd ehci_pci ohci_hcd ohci_pci uhci_hcd \
           usb_storage uas sd_mod sr_mod usbhid \
           virtio_blk virtio_pci ahci libahci ata_piix nvme nvme_core; do
    /bin/busybox modprobe "$mod" 2>/dev/null
done
echo "[init] drivers loaded"

# Ждём появления блочных устройств
# FIX: добавлены партиции — Rufus в ISO-режиме создаёт таблицу разделов,
#      squashfs лежит внутри /dev/sdX1, а не в /dev/sdX.
echo "[init] waiting for block devices..."
i=0
while [ $i -lt 60 ]; do
    if [ -b /dev/sda ] || [ -b /dev/sr0 ] || [ -b /dev/vda ] || \
       [ -b /dev/nvme0n1 ] || [ -b /dev/sda1 ] || [ -b /dev/vda1 ] || \
       [ -b /dev/nvme0n1p1 ]; then
        echo "[init] block device appeared after ${i}s"
        break
    fi
    /bin/busybox sleep 1
    i=$((i+1))
done

echo "[init] block devices:"
ls -la /dev/sd* /dev/sr* /dev/vd* /dev/nvme* 2>/dev/null || echo "  (none)"

# FIX: /mnt/root уже создан выше (строка mkdir), повторный mkdir без -p
#      возвращал ошибку. Убираем дубликат.
ROOT_DEV=""
CANDS="/dev/sr0 /dev/sda /dev/sdb /dev/vda /dev/nvme0n1 \
       /dev/sda1 /dev/sda2 /dev/sda3 /dev/sda4 \
       /dev/sdb1 /dev/sdb2 /dev/sdb3 /dev/sdb4 \
       /dev/vda1 /dev/vda2 /dev/nvme0n1p1 /dev/nvme0n1p2"

for fs in udf iso9660 vfat ext4; do
    for dev in $CANDS; do
        [ -b "$dev" ] || continue
        echo "[init] try $dev as $fs"
        if /bin/busybox mount -t "$fs" -o ro "$dev" /mnt/root 2>/dev/null; then
            if [ -f /mnt/root/filesystem.squashfs ]; then
                echo "[init] *** FOUND on $dev ($fs) ***"
                ROOT_DEV=$dev
                break 2
            fi
            /bin/busybox umount /mnt/root
        fi
    done
done

# Fallback: если что-то пошло не так — остаёмся в initramfs с шеллом.
# ВАЖНО: init не должен завершаться, иначе ядро паникует
# ("Attempted to kill init! exitcode=0x00000000").
fallback_shell() {
    echo "[init] falling back to busybox shell"
    cd /
    while true; do
        setsid -c /bin/busybox sh </dev/console >/dev/console 2>&1 || /bin/busybox sleep 5
    done
}

if [ -z "$ROOT_DEV" ]; then
    echo "[init] !!! filesystem.squashfs NOT FOUND !!!"
    fallback_shell
fi

echo "[init] mounting squashfs..."
/bin/busybox mkdir -p /mnt/squashfs
if ! /bin/busybox mount -t squashfs -o loop,ro /mnt/root/filesystem.squashfs /mnt/squashfs; then
    echo "[init] !!! squashfs mount failed !!!"
    fallback_shell
fi

echo "[init] setting up overlayfs..."
/bin/busybox mkdir -p /mnt/overlay
/bin/busybox mount -t tmpfs tmpfs /mnt/overlay
/bin/busybox mkdir -p /mnt/overlay/upper /mnt/overlay/work

/bin/busybox mkdir -p /mnt/newroot
if ! /bin/busybox mount -t overlay overlay \
    -o lowerdir=/mnt/squashfs,upperdir=/mnt/overlay/upper,workdir=/mnt/overlay/work \
    /mnt/newroot; then
    echo "[init] !!! overlay mount failed !!!"
    fallback_shell
fi

if [ ! -x /mnt/newroot/usr/lib/systemd/systemd ]; then
    echo "[init] !!! systemd not found !!!"
    fallback_shell
fi

echo "[init] switch_root -> systemd"
exec /bin/busybox switch_root /mnt/newroot /usr/lib/systemd/systemd