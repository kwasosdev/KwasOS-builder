# Все текстовые файлы хранятся в git с LF
* text=auto eol=lf

# Исполняемые скрипты и конфиги — строго LF (CRLF ломает busybox init, grub, os-release)
*.sh        text eol=lf
*.cfg       text eol=lf
Makefile    text eol=lf
init        text eol=lf
os-release  text eol=lf
hostname    text eol=lf

# Бинарные файлы
*.iso       binary
*.squashfs  binary
*.gz        binary
*.xz        binary
*.zst       binary
*.tar       binary
